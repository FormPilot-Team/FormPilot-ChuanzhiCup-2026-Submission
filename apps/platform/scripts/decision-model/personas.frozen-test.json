    "topKind": "kind of the first item in the unified priority order (chapter | game)",
    "minDistinctPrograms": "recommended chapters come from at least N routine programmes",
    "minChapterRegionPrecision": "mean over recommended chapters of |chapter regions within selected| / |chapter regions| is at least the value",
    "excludeIds": "none of these ids (or chapters of these programmes) appear under the given host availability",
