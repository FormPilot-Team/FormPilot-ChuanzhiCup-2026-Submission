# FormPilot Web V1.2 · AI 教练本地 LLM Agent 环境变量模板（没有任何 API Key，也不需要）
# 复制后在启动 Bridge 的终端里设置；不要提交真实令牌。

# ---- Agent Bridge（node server/coachAgent/agent/index.ts）----
FP_AGENT_ENABLED=true                     # 未设为 true 时 Bridge 拒绝启动
FP_AGENT_PORT=4321                        # Bridge 监听 127.0.0.1:<port>
FP_AGENT_OLLAMA_PORT=11441                # 本机 Ollama 端口（仅回环地址）
FP_AGENT_MODEL=qwen3:4b-instruct-2507-q4_K_M   # 只接受固定 tag，digest 必须为 0edcdef34593…
FP_AGENT_ORIGINS=http://127.0.0.1:4173,http://localhost:4175   # 允许调用的页面 Origin（精确匹配）
FP_AGENT_RPM=40                           # 每分钟请求上限（评测时可调高）
FP_AGENT_PRELOAD=true                     # 启动时把模型载入显存，避免首个问题等待冷启动
# FP_AGENT_ACCESS_TOKEN=                  # 可选：32–256 位 [A-Za-z0-9_-]，设置后每个请求需 Bearer；不要写进仓库

# ---- Web 构建（Vite）----
# VITE_COACH_AGENT_URL=http://127.0.0.1:4321   # 只接受 http 回环地址
# VITE_COACH_AGENT=off                         # 构建无 LLM 版本：不探测 Bridge，自由提问显示「本构建未启用」
