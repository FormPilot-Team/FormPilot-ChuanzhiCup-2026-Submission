{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "体感游戏工坊",
  "mainBinaryName": "MotionGamesLab",
  "version": "1.0.0",
  "identifier": "com.motiongameslab.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5180",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "体感游戏工坊",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "backgroundColor": "#cfe9d6"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Motion Games Lab",
    "copyright": "Motion Games Lab",
    "category": "Game",
    "shortDescription": "体感游戏工坊：摘苹果、林间划船、林间射箭",
    "longDescription": "用摄像头识别身体动作的三款小游戏。摄像头画面只在本机用于动作识别，不录像、不上传。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
