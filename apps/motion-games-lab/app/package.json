{
  "name": "motion-games-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/copy-mediapipe-wasm.mjs",
    "dev": "node scripts/copy-mediapipe-wasm.mjs && vite --host 127.0.0.1 --port 5180",
    "build": "node scripts/copy-mediapipe-wasm.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5181 --strictPort",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "perf": "node scripts/perf.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "phaser": "3.90.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
